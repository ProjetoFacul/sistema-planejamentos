datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String  // Senha do professor
  role     String  // "TEACHER" ou "COORDINATOR"
  plans    LessonPlan[]
}

model Class {
  id    Int    @id @default(autoincrement())
  name  String
  plans LessonPlan[]
}

model Subject {
  id    Int    @id @default(autoincrement())
  name  String
  plans LessonPlan[]
}

model Period {
  id    Int    @id @default(autoincrement())
  name  String
  plans LessonPlan[]
}

model LessonPlan {
  id         Int       @id @default(autoincrement())
  content    String    @db.Text
  status     String    // "DRAFT" ou "SUBMITTED"
  sentAt     DateTime?

  teacherId  Int
  teacher    User      @relation(fields: [teacherId], references: [id])
  classId    Int
  class      Class     @relation(fields: [classId], references: [id])
  subjectId  Int
  subject    Subject   @relation(fields: [subjectId], references: [id])
  periodId   Int
  period     Period    @relation(fields: [periodId], references: [id])

  @@unique([teacherId, classId, subjectId, periodId])
}